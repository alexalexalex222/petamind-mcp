# Google Cloud (Vertex AI)
GOOGLE_CLOUD_PROJECT=your-project-id
GOOGLE_CLOUD_REGION=us-central1

# Gemini (optional, for vision judge without ADC)
# Either env var works (GeminiProvider checks both)
GOOGLE_API_KEY=
GEMINI_API_KEY=

# OpenRouter
OPENROUTER_API_KEY=sk-or-v1-xxxxx

# Optional: GCS backup
GCS_BUCKET=

# Optional: Override config file
TITAN_CONFIG_PATH=
